Project ID: Open PAF Python Example

Package Information:
  Name: Python Example
  Version: 1.1.3
  Required QTM version: 2.16.3600
  Encoding bytes: €€€€€

Root type: Subject
Default fields: [Creation date, Creation time]
Date format: Iso
Date separator: Dash
Filename filter: '\.(qtm)$'

Types:
  Subject:
    Participant:
      # These originate at Participant level and are linked to each Session
      # and its Static / Dynamic measurements through Inherit: Connect.
      Fields: [ID, Name, DOB, Height, BodyMass, Sex]
      Display order: [ID, Name, DOB, Height, BodyMass, Sex, Comments]
      Children: [Session]
      Directory pattern: $Name$_$ID$

  Session:
    Session:
      # Do not redeclare the inherited Participant fields here: that could
      # make independent values rather than edit the connected originals.
      Fields: [Session ID, Operator, InterAsisDistance, LeftLegLength, RightLegLength, LeftKneeWidth, RightKneeWidth, LeftAnkleWidth, RightAnkleWidth, LeftAsisTrocanterDistance, RightAsisTrocanterDistance]
      # All patient fields are visible/editable in the Session Details pane.
      # Changing linked Participant fields here also changes the Participant
      # and all its linked Sessions and measurements.
      Display order: [Session ID, Operator, ID, Name, DOB, Sex, Height, BodyMass, InterAsisDistance, LeftLegLength, RightLegLength, LeftKneeWidth, RightKneeWidth, LeftAnkleWidth, RightAnkleWidth, LeftAsisTrocanterDistance, RightAsisTrocanterDistance, Comments]
      Measurements: [Static, Dynamic]
      Analyses: [Shriner Static]
      Directory pattern: $Creation date$_$Session ID$

Measurements:
  Fields:
    Measurement length: 30
    Minimum count: 1
    Maximum count: 20
    Count: 1

  Static:
    Measurement length: 1
    Minimum count: 1
    Maximum count: 20
    Count: 1
    Measurement type: Static
    AIM models: Static.qam

  Dynamic:
    Minimum count: 1
    Maximum count: 20
    Count: 3
    Measurement type: Dynamic
    AIM models: Dynamic.qam

Analyses:
  Shriner Static:
    Type: External program
    Program display name: Command Prompt
    Export session: Yes
    Export measurements: c3d
    Arguments: ['/C $TemplateDirectory$\run_python_example.bat']

Fields:
  ID:
    Type: String
    Inherit: Connect

  Name:
    Type: String
    Inherit: Connect
    Force: Yes

  DOB:
    Type: Date
    Readonly: No
    Inherit: Connect

  Creation date:
    Type: Date
    Readonly: No

  Creation time:
    Type: TimeOfDay
    Readonly: No

  Session ID:
    Type: String
    Inherit: Connect

  Operator:
    Type: String
    Inherit: Connect

  BodyMass:
    Type: Float
    Quantity: Mass
    Unit: kilograms
    Decimals: 1
    Readonly: No
    Inherit: Connect
    Max: 250
    Min: 0

  Height:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Max: 2.5
    Min: 0.5

  InterAsisDistance:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.1
    Max: 0.4

  LeftLegLength:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.6
    Max: 1.2

  LeftAsisTrocanterDistance:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0
    Max: 0.3

  LeftKneeWidth:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.06
    Max: 0.15

  LeftAnkleWidth:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.05
    Max: 0.12

  RightLegLength:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.6
    Max: 1.2

  RightAsisTrocanterDistance:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0
    Max: 0.3

  RightKneeWidth:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.06
    Max: 0.15

  RightAnkleWidth:
    Type: Float
    Quantity: Length
    Unit: m
    Decimals: 3
    Readonly: No
    Inherit: Connect
    Min: 0.05
    Max: 0.12

  Sex:
    Type: Enum
    Values: [Female, Male, Other]
    Inherit: Connect

  Measurement type:
    Type: String

Columns:
  Default column definitions:
    ID:
      Width: 160
      Fields:
        Default: Filename
        Participant: ID
    Name:
      Width: 150
      Fields:
        Participant: Name
        Session: Name
    Height (m):
      Width: 100
      Fields:
        Default: Height
        Session:
          Name: Height
          Editable: Yes
    Weight (kg):
      Width: 100
      Fields:
        Default: BodyMass
        Session:
          Name: BodyMass
          Editable: Yes
    Inter-ASIS (m):
      Width: 105
      Fields:
        Default: InterAsisDistance
        Session:
          Name: InterAsisDistance
          Editable: Yes
    Created:
      Width: 90
      Field: Creation date
    Comments:
      Width: 120
      Field: Comments

# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific settings.
# NEVER commit the actual '.env' file containing production credentials or paths.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# Qualisys Track Manager (QTM) RT Protocol Connection
QTM_HOST=127.0.0.1
QTM_PORT=22223
QTM_RT_VERSION=1.25
QTM_CONTROL_PASSWORD=replace_with_secure_qtm_password

# QTM gRPC Bridge Service Configuration
GRPC_SERVER_HOST=127.0.0.1
GRPC_SERVER_PORT=50051

# Clinical / Patient Data Storage Location
# Path to local or network-attached secure clinical data storage (outside Git tracking)
PATIENTS_DATA_LOCATION=./Data

# Security & Encryption (Required for production clinical deployments)
# Generate a cryptographically secure random key (e.g., via `openssl rand -hex 32`)
ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key
API_SECRET_KEY=replace_with_secure_random_api_secret

# Auto detect text files and perform LF normalization on checkin
* text=auto

# Source code files
*.py text eol=lf
*.proto text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Configuration and Documentation
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.paf text eol=lf

# Image and UI assets (Binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Spreadsheets and 3D Models
*.xls binary
*.xlsx binary
*.obj binary
*.qam binary

# Motion capture / clinical data formats (Mark as binary if ever encountered)
*.c3d binary
*.qtm binary
*.GCD binary
*.gcd binary
*.avi binary
*.mp4 binary
